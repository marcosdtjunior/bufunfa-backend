{
    "version": 2,
    "builds": [
        {
            "src": "src/index.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "src/index.ts"
        }
    ],
    "buildCommand": "npm install && npm run dev",
    "functions": {
        "src/routes.ts": {
            "includeFiles": "node_modules/.prisma/client/**/*"
        }
    }
}